node_modules/
dist/
build/
.vite/

# --- 生成物: コミットしない（決定 D7 / docs/01 §1.5） ---
# モデルは CI が取得・量子化して Pages 成果物に同梱する
public/models/
# ONNX Runtime の wasm は scripts/copy_ort.mjs が node_modules から複製する
public/ort/
*.onnx
*.onnx_data
# 例外: PoC-2 のスレッド計測に使う合成モデル。scripts/make_threadbench.py が
# 決定的に生成する小さなファイルなので、リポジトリに入れて CI での再生成を省く。
!public/threadbench.onnx

# 実測ログの作業ファイル
scratch/

# テスト実行成果物（トレース・スクリーンショット）
tests/results/
playwright-report/

# Python のバイトコード（誤ってコミットされていた）
__pycache__/
*.pyc

# 実素材で位置合わせを測るときの中間ファイル（scripts/multiview_probe.py）
.cache/
tests/multiview-probe/
